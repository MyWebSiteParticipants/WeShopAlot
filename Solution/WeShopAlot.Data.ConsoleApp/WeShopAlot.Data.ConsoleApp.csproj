<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The database seeder: drops the WSA schema, applies the migrations, loads the sample
    catalog, and exits. The seeding code and the data live in WeShopAlot.Data (Seed/), so the
    integration tests use the same path; this project is only the command-line way to run it.
    It is also the startup project for "dotnet ef" (see DesignTimeContextFactory).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UserSecretsId>39f3036b-6081-45eb-91f3-9f35aa951f79</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- No IncludeAssets line here: DesignTimeContextFactory implements IDesignTimeDbContextFactory, so this project compiles against the package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pins the patched version of a transitive dependency (NU1903 below 10.0.13), as WeShopAlot.Testing.Unit does. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeShopAlot.Data\WeShopAlot.Data.csproj" />
  </ItemGroup>

  <!-- Product pictures, kept with the seed data they belong to. The API serves its own copy from WeShopAlot..WebAPI/Content. -->
  <ItemGroup>
    <None Update="Content\images\products\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
